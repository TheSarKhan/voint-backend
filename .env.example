# voint-backend env dəyişənləri — `docker run --env-file .env` / deploy üçün.
# Local `./mvnw spring-boot:run` üçün əvəzinə repo kökündəki application-local.yml istifadə edin.
# Nüsxə çıxarın: cp .env.example .env

# ---- Profil: local (host-da) | docker (compose network-də)
SPRING_PROFILES_ACTIVE=docker

# ---- Datasource (docker profilində host `postgres`)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/voint
SPRING_DATASOURCE_USERNAME=voint
SPRING_DATASOURCE_PASSWORD=changeme

# ---- Redis (docker profilində host `redis`)
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# ---- Təhlükəsizlik
# HS256, min 32 bayt. Generasiya: openssl rand -hex 32
JWT_SECRET=changeme-min-32-bytes-0123456789abcdef
# platform_settings credential-larını qoruyan AES açarı. Boş qalsa JWT_SECRET-ə fallback edir —
# o halda JWT_SECRET-i rotasiya etmək saxlanmış bütün credential-ları oxunmaz edir.
VOINT_SECRETS_KEY=

# ---- Gemini (boşdursa MockLlmClient)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=400

# ---- Vapi / STT / TTS
VAPI_PRIVATE_KEY=
# Vapi dashboard-dakı "Server URL Secret". Boş = webhook yoxlaması söndürülüb.
VAPI_WEBHOOK_SECRET=
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- SMTP (panel login + parol sıfırlama). Beşi də dolu olmalıdır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Domen
# Vapi bu ünvana zəng edir (custom-LLM + hadisə webhook-u). Dəyişdirdikdən sonra
# POST /api/v1/tenants/vapi-sync-all çağırılmalıdır - yoxsa Vapi-dəki assistant-lar
# köhnə ünvanda qalır və zənglər sınır.
VOINT_PUBLIC_BASE_URL=https://app.voint.az
# Müəssisə panelləri bu domenin altındadır: texnika.<domen>. Xoş gəlmisiniz e-poçtundakı
# giriş linki bundan qurulur.
VOINT_PANEL_DOMAIN=voint.az

# ---- Digər
VOINT_AI_FOLDER=./ai
VOINT_BILLING_ZONE=Asia/Baku
VOINT_USD_TO_AZN=1.70
# Prod-da deploy origin-ləri əlavə edin (məs. https://landing-voint.sarkhan.az)
VOINT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:3000
